# Agent Flight Recorder — environment configuration
# Copy to backend/.env for local dev, or keep at repo root for docker compose.

# --- execution mode ----------------------------------------------------------
# "replay" (default): the public demo. Serves the bundled library of recorded
#            execution traces. No LLM is ever called, nothing is fabricated,
#            and no API key is needed.
# "live"   : executes real agent runs against an OpenAI-compatible endpoint.
#            Requires OPENAI_API_KEY (bring your own key). Live mode is never
#            silently downgraded — without a key the API reports
#            "Live execution unavailable." instead of falling back.
AFR_MODE=replay

# --- live-mode provider (only read when AFR_MODE=live) -----------------------
# Any OpenAI-compatible /chat/completions endpoint works via OPENAI_BASE_URL
# (OpenAI, Azure, vLLM, Ollama, LM Studio...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/flight_recorder.db

# --- agent -------------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_TOOL_RETRY_LIMIT=1
FILE_READER_ROOT=./sample_data
