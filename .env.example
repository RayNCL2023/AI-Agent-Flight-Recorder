# Agent Flight Recorder — environment configuration
# Copy to backend/.env for local dev, or keep at repo root for docker compose.

# --- LLM provider -----------------------------------------------------------
# "mock"   : deterministic offline provider, no key needed (default — the full
#            product works without any external service)
# "openai" : any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/flight_recorder.db

# --- agent -------------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_TOOL_RETRY_LIMIT=1
FILE_READER_ROOT=./sample_data
